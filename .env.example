# PaperTales AI Environment Variables

# PayPal Developer Sandbox (https://developer.paypal.com/dashboard/)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=test_client_id
PAYPAL_CLIENT_SECRET=test_client_secret
PAYPAL_ENVIRONMENT=sandbox

# Lulu Developer Sandbox (https://developers.lulu.com/)
LULU_CLIENT_KEY=test_lulu_client_key
LULU_CLIENT_SECRET=test_lulu_client_secret
LULU_ENVIRONMENT=sandbox

# Channel3 Product Catalog (https://trychannel3.com/)
CHANNEL3_API_KEY=test_channel3_key

# Gemini AI / Vision API
GEMINI_API_KEY=test_gemini_key
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_COVER_IMAGE_MODEL=gemini-3.1-flash-image

# Google Cloud Platform (dedicated project: papertale-studio)
GCP_PROJECT_ID=papertale-studio
GCS_BUCKET=papertale-studio-assets
REQUIRE_AUTH=true

# PayPal Webhook ID (for signature verification)
PAYPAL_WEBHOOK_ID=test_paypal_webhook_id

# Firebase Web Client & App Check (public client config)
NEXT_PUBLIC_FIREBASE_API_KEY=test_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=papertale-studio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=papertale-studio
NEXT_PUBLIC_FIREBASE_APP_ID=1:5293527863:web:94db514e7357b587b280b2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=test_recaptcha_site_key
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
